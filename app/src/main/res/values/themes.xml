<resources>
    <!-- Compose draws the UI; this theme only covers the window before the first frame. -->
    <style name="Theme.CryptoMania" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cm_background</item>
    </style>

    <style name="Theme.CryptoMania.Starting" parent="Theme.SplashScreen">
        <!-- Plain brand blue: the Compose AnimatedSplash starts on the same color and draws the logo. -->
        <item name="windowSplashScreenBackground">@color/cm_brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.CryptoMania</item>
    </style>
</resources>
